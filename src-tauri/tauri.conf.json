{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nacho Viewer",
  "version": "0.1.0",
  "identifier": "io.github.nuncaeslupus.NachoViewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Nacho Viewer", "width": 1000, "height": 800, "decorations": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' image: http://image.localhost data: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "fileAssociations": [
      { "ext": ["md", "markdown"], "name": "Markdown document", "mimeType": "text/markdown", "role": "Viewer" }
    ],
    "shortDescription": "A Markdown viewer that reads like a well-typeset document",
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 448 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "linux": {
      "deb": { "desktopTemplate": "linux/nacho-viewer.desktop" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGQTRGNjFBQTlDNkUyREYKUldUZjRzYXBHdmFrNyswSWJndngraTdkNFBLZGFFVng2Ujh5bjJiQzU4RDBoaHA0disrZ0cxTEoK",
      "endpoints": ["https://github.com/nuncaeslupus/nacho-viewer/releases/latest/download/latest.json"]
    }
  }
}
